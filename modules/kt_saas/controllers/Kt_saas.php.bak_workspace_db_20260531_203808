        if (!empty($result['success'])) {
            $message = 'Đã kiểm tra tên miền. Mức sẵn sàng: ' . strtoupper((string) $result['readiness_status']) . ', DNS: ' . strtoupper((string) $result['dns_status']) . ', SSL: ' . strtoupper((string) $result['ssl_status']) . '.';
