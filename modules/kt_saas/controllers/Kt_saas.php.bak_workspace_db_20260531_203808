                    $ok = !empty($result['success']);
                }
            } elseif ($action === 'export') {
                $ok = true;
            }

            if ($ok) {
                $processed++;
            } else {
                $failed++;
            }
        }

        if ($action === 'export') {
            $rows = [];
            foreach ($ids as $id) {
                $plan = $this->Kt_saas_model->get_plan($id);
                if ($plan) {
                    $rows[] = $plan;
