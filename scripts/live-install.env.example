# Copy this file to a private path on the live server, for example:
# cp scripts/live-install.env.example /root/khachtot-install.env
# chmod 600 /root/khachtot-install.env

APP_DOMAIN="crm.example.com"
APP_SUBDOMAINS="www.crm.example.com api.crm.example.com"
PROJECT_PATH="/var/www/khachtot"
DEPLOY_USER="www-data"
DEPLOY_GROUP="www-data"

SYNC_COMMIT="25d56dee5233997e859921a275ce0a53841ab5a5"
REPO_URL="https://github.com/xemthach/khachtot-crm.git"

DB_HOST="127.0.0.1"
DB_NAME="khachtot"
DB_USER="khachtot_user"
DB_PASSWORD="CHANGE_ME"
APP_ENC_KEY="CHANGE_ME_TO_A_RANDOM_32_CHAR_SECRET"

# Set true only when the DB admin credentials are available.
CREATE_DATABASE=false
DB_ADMIN_USER="root"
DB_ADMIN_PASSWORD="CHANGE_ME"

# Leave empty to auto-detect /run/php/php*-fpm.sock.
PHP_FPM_SOCKET=""
NGINX_SITE="/etc/nginx/sites-available/crm.example.com.conf"
NGINX_LINK="/etc/nginx/sites-enabled/crm.example.com.conf"
CRON_LOG_PATH="/var/log/khachtot"
